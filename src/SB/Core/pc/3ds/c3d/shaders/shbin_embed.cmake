# cmake -DIN=<c3d.shbin> -DOUT=<c3d_shbin.h> -P shbin_embed.cmake
#
# The citro3d shader binary as a C++ array (CMakeLists.txt, TSSM_BACKEND_C3D),
# so the program carries it without a RomFS lookup. Also refuses a binary over
# the PICA's program memory, 512 instructions and 128 operand descriptors:
# libctru's upload stops silently at those counts.

file(READ "${IN}" _hex HEX)
string(LENGTH "${_hex}" _len)
math(EXPR _bytes "${_len} / 2")

# DVLB: "DVLB", the DVLE count, an offset per DVLE, then the DVLP: "DVLP",
# version, code offset, code words, operand descriptor offset and count.
string(SUBSTRING "${_hex}" 8 8 _ndvle_le)
macro(le32 out hexle)
  string(SUBSTRING "${hexle}" 0 2 _b0)
  string(SUBSTRING "${hexle}" 2 2 _b1)
  string(SUBSTRING "${hexle}" 4 2 _b2)
  string(SUBSTRING "${hexle}" 6 2 _b3)
  math(EXPR ${out} "0x${_b3}${_b2}${_b1}${_b0}" OUTPUT_FORMAT DECIMAL)
endmacro()
le32(_ndvle "${_ndvle_le}")
math(EXPR _dvlp "8 + 4 * ${_ndvle}")
math(EXPR _at "(${_dvlp} + 12) * 2")
string(SUBSTRING "${_hex}" ${_at} 8 _w)
le32(_code "${_w}")
math(EXPR _at "(${_dvlp} + 20) * 2")
string(SUBSTRING "${_hex}" ${_at} 8 _w)
le32(_opdesc "${_w}")
if(_code GREATER 512 OR _opdesc GREATER 128)
  message(FATAL_ERROR "${IN}: ${_code} instructions and ${_opdesc} operand descriptors; "
                      "the PICA holds 512 and 128")
endif()

string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _array "${_hex}")
file(WRITE "${OUT}.tmp"
  "// Generated by shbin_embed.cmake from c3d.shbin (${_ndvle} programs, ${_code} instructions,\n"
  "// ${_opdesc} operand descriptors). Do not edit.\n"
  "alignas(4) static const unsigned char kC3dShbin[${_bytes}] = {${_array}};\n")
file(RENAME "${OUT}.tmp" "${OUT}")
