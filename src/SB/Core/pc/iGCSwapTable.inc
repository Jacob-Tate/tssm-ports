        return true;
    }
    return false;
}

// The types read as they are: RenderWare streams, sound data, and the
// ones the GameCube disc ships little-endian already.
static bool iGCSwapGeneratedAsIs(U32 type)
{
    switch (type)
    {
    case 0x43535353: // 'CSSS'
    case 0x464C5920: // 'FLY '
    case 0x4D4F444C: // 'MODL'
    case 0x52415720: // 'RAW '
    case 0x52575458: // 'RWTX'
    case 0x534E4420: // 'SND '
    case 0x534E4449: // 'SNDI'
    case 0x534E4453: // 'SNDS'
    case 0x54455853: // 'TEXS'
        return true;
    }
    return false;
}
