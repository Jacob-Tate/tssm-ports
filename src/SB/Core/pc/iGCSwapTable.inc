    case 0x504C5952: // 'PLYR'
    case 0x504F5254: // 'PORT'
    case 0x52414E4D: // 'RANM'
    case 0x53435250: // 'SCRP'
    case 0x53444658: // 'SDFX'
    case 0x53475250: // 'SGRP'
    case 0x53485250: // 'SHRP'
