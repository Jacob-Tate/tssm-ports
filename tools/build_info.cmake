# build_info.cmake: writes the build-info source (src/SB/Core/pc/iBuildInfo.h)
# with this build's time, version and git commit. CMakeLists.txt runs it on
# every build, so the stamp in crash.log, last_run.log and the About tab is the
# build's own, not the day one file last recompiled (__DATE__).
#
#   cmake -DOUT=<file.cpp> -DSRC=<source dir> -DVERSION=<version> [-DGIT=<git>] -P build_info.cmake
#
# The commit is "unknown" outside a git checkout or without git, and carries
# "-dirty" when tracked files differ from it. Submodules whose own files differ
# (third_party/librw with the port's patches applied) do not count.

if(NOT OUT OR NOT SRC)
  message(FATAL_ERROR "build_info.cmake: give -DOUT=<file> and -DSRC=<source dir>")
endif()
if(NOT VERSION)
  set(VERSION "unknown")
endif()
if(NOT GIT)
  set(GIT git)
endif()

string(TIMESTAMP _time "%Y-%m-%d %H:%M:%S")

set(_commit "unknown")
execute_process(COMMAND "${GIT}" rev-parse --short=10 HEAD
                WORKING_DIRECTORY "${SRC}"
                RESULT_VARIABLE _rc OUTPUT_VARIABLE _head
                OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(_rc EQUAL 0 AND _head MATCHES "^[0-9a-f]+$")
  set(_commit "${_head}")
  execute_process(COMMAND "${GIT}" status --porcelain --untracked-files=no --ignore-submodules=dirty
                  WORKING_DIRECTORY "${SRC}"
                  RESULT_VARIABLE _rc OUTPUT_VARIABLE _changes
                  OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT _rc EQUAL 0 OR NOT _changes STREQUAL "")
    string(APPEND _commit "-dirty")
  endif()
endif()

set(_text "// Generated by tools/build_info.cmake on every build. Do not edit.\n")
string(APPEND _text "#include \"iBuildInfo.h\"\n\n")
string(APPEND _text "const char iBuildVersion[] = \"${VERSION}\";\n")
string(APPEND _text "const char iBuildCommit[] = \"${_commit}\";\n")
string(APPEND _text "const char iBuildTime[] = \"${_time}\";\n")

# Rewritten only when it differs, so two builds in one second compile it once.
set(_old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" _old)
endif()
if(NOT _old STREQUAL _text)
  file(WRITE "${OUT}" "${_text}")
endif()
