+// Reset at the size the present parameters have now, whatever the window's
+// is. Exclusive full screen is reset this way: its size is the display
+// mode's, and its window is some other size on the way back from being
+// minimised.
+bool32
+resetDevice(void)
+{
+	releaseVideoMemory();
+	HRESULT res = d3ddevice->Reset(&d3d9Globals.present);
+	restoreVideoMemory();
+	return SUCCEEDED(res);
+}
