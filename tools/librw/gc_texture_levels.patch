+int32
+readGCTextureLevels(const uint8 *buf, uint32 length, Image **levels, int32 maxLevels,
+	const char **why)
+{
+	const char *dummy;
+	if(why == nil)
+		why = &dummy;
+	*why = nil;
+	if(length < GC_PALETTE + 4){
+		*why = "struct too short";
+		return 0;
+	}
+
+	int32 width = be16(buf + 0x5C);
+	int32 height = be16(buf + 0x5E);
+	int32 numLevels = buf[0x61];
+	int32 fmt = buf[0x62];
+	int32 palfmt = buf[0x63];
+
+	int32 tw, th, tbytes;
+	if(!tileShape(fmt, &tw, &th, &tbytes)){
+		*why = "a GX texture format this cannot read";
+		return 0;
+	}
+	if(width <= 0 || height <= 0 || width > GC_MAX_SIZE || height > GC_MAX_SIZE){
+		*why = "size out of range";
+		return 0;
+	}
+	if(numLevels < 1)
+		numLevels = 1;
+	if(numLevels > Raster::calculateNumLevels(width, height) || numLevels > GC_MAX_LEVELS ||
+	   numLevels > maxLevels){
+		*why = "more levels than the size allows";
+		return 0;
+	}
+	bool32 paletted = fmt == GX_TF_C4 || fmt == GX_TF_C8;
+	if(paletted && palfmt != GX_TL_IA8 && palfmt != GX_TL_RGB565 && palfmt != GX_TL_RGB5A3){
+		*why = "a GX palette format this cannot read";
+		return 0;
+	}
+
+	const uint8 *pal = buf + GC_PALETTE;
+	uint32 off = GC_PALETTE;
+	if(paletted)
+		off += (fmt == GX_TF_C4 ? 16 : 256)*2;
+	if(off + 4 > length){
+		*why = "struct too short for its palette";
+		return 0;
+	}
+	uint32 stored = be32(buf + off);
+	off += 4;
+
+	uint32 need = 0;
+	for(int32 i = 0; i < numLevels; i++){
+		int32 w = width >> i, h = height >> i;
+		need += levelBytes(w ? w : 1, h ? h : 1, tw, th, tbytes);
+	}
+	if(need > length - off || need > stored){
+		*why = "struct too short for its levels";
+		return 0;
+	}
+
+	const uint8 *pix = buf + off;
+	for(int32 i = 0; i < numLevels; i++){
+		int32 w = width >> i, h = height >> i;
+		if(w == 0) w = 1;
+		if(h == 0) h = 1;
+		levels[i] = decodeLevel(pix, w, h, fmt, pal, palfmt, tw, th, tbytes);
+		pix += levelBytes(w, h, tw, th, tbytes);
+	}
+	return numLevels;
+}
+
+Image*
+readGCTextureImage(const uint8 *buf, uint32 length)
+{
+	Image *levels[GC_MAX_LEVELS];
+	int32 n = readGCTextureLevels(buf, length, levels, GC_MAX_LEVELS, nil);
+	if(n == 0)
+		return nil;
+	for(int32 i = 1; i < n; i++)
+		levels[i]->destroy();
+	return levels[0];
+}
