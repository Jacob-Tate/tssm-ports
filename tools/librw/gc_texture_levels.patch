+// A level half the size of `src`, each texel the mean of the 2x2 it covers.
+static Image*
+halveImage(Image *src)
+{
+	int32 w = src->width > 1 ? src->width/2 : 1;
+	int32 h = src->height > 1 ? src->height/2 : 1;
+	Image *img = Image::create(w, h, 32);
+	img->allocate();
+	for(int32 y = 0; y < h; y++)
+		for(int32 x = 0; x < w; x++)
+			for(int32 c = 0; c < 4; c++){
+				int32 x0 = x*2 < src->width ? x*2 : src->width-1;
+				int32 y0 = y*2 < src->height ? y*2 : src->height-1;
+				int32 x1 = x0+1 < src->width ? x0+1 : x0;
+				int32 y1 = y0+1 < src->height ? y0+1 : y0;
+				uint32 s = src->pixels[y0*src->stride + x0*4 + c] +
+				           src->pixels[y0*src->stride + x1*4 + c] +
+				           src->pixels[y1*src->stride + x0*4 + c] +
+				           src->pixels[y1*src->stride + x1*4 + c];
+				img->pixels[y*img->stride + x*4 + c] = (s + 2)/4;
+			}
+	return img;
+}
