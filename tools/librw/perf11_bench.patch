 void registerNativeRaster(void);
 #define GETGL3RASTEREXT(raster) PLUGINOFFSET(Gl3Raster, raster, rw::gl3::nativeRasterOffset)
 
+// TSSM port: per-frame GPU counters and GPU time (gl3perf.inc). Nothing is
+// counted or timed until perfStart, called once the window and context exist.
+struct PerfCounts
+{
+	uint32 draws, tris, passes, screenPasses, blits, clears, programs, textureBinds;
+	uint32 texUploads, texBytes, bufUploads, bufBytes;
+};
+struct PerfInfo
+{
+	const char *renderer, *version;
+	int32 gles, timers, samplesWanted, samples;
+	int32 screenWidth, screenHeight, windowWidth, windowHeight;
+};
+bool32 perfStart(void);
+bool32 perfTimers(void);
+void perfInfo(PerfInfo *info);
+// The frame's first camera: its GPU query opened.
+void perfFrameBegin(void);
+// After the swap of `frame`: its counters, and its GPU query closed.
+void perfFrame(uint32 frame, PerfCounts *out);
+// One finished GPU time, oldest first, without waiting; false when none is ready.
+bool32 perfGpuPoll(uint32 *frame, float32 *ms);
+uint32 perfGpuDropped(void);
+
 }
 }
