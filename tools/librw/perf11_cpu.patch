+// TSSM port (perf11_cpu): run-time switches for comparing against the old
+// paths, read once when the device starts. Unset means on.
+static bool32
+cpuOptSwitch(const char *name)
+{
+	const char *e = getenv(name);
+	return e == nil || *e == '\0' || atoi(e) != 0;
+}
+
+// TSSM port (perf11_cpu): one vertex array object per instanced geometry and
+// one per immediate-mode stream, so that a draw binds one object instead of
+// setting every attribute up again. That was two buffer binds and an enable,
+// a pointer and a disable per attribute for every atomic: 73% of the 6000 GL
+// calls of a frame in SC02. A GLES driver such as Adreno's runs those on the
+// game thread and validates the vertex state again at each draw.
+//
+// Only where the context has them (GL 3.0, GLES 3.0); TSSM_GL_VAO=0 turns
+// them off for comparison. Decided in initOpenGL, before anything is
+// instanced, and never changed after.
+//
+// The binding is cached like the texture and framebuffer ones. vao, the one
+// object every draw used before, is bound again after instancing, so that GL
+// calls from outside librw that set attributes without a vertex array of their
+// own land in it and never in a geometry's.
+bool32 useVaos;
+static uint32 boundVertexArray = ~0u;
+
+void
+bindVertexArray(uint32 v)
+{
+	if(boundVertexArray != v){
+		boundVertexArray = v;
+		glBindVertexArray(v);
+	}
+}
+
+void
+bindDefaultVertexArray(void)
+{
+	if(gl3Caps.glversion >= 30)
+		bindVertexArray(vao);
+}
+
+// Deleting the bound vertex array leaves 0 bound, and the name can be handed
+// out again: the cache must not keep claiming it.
+void
+forgetVertexArray(uint32 v)
+{
+	if(boundVertexArray == v)
+		boundVertexArray = ~0u;
+}
+
+#ifdef LIBRW_SDL3
+// TSSM port (perf11_cpu): the swap interval is set when it changes rather than
+// before every swap. SDL passes every call on to eglSwapInterval or
+// wglSwapIntervalEXT; NVIDIA's waits on its driver thread, 0.6 ms a frame, and
+// on Android each call goes to the surface's buffer queue. The interval
+// belongs to the context and its surface: initOpenGL forgets it for a new
+// context, and on Android SDL sets it again itself when the window gets a new
+// surface (android_egl_context_restore). A failed call is tried again on the
+// next swap. TSSM_GL_SWAP_CACHE=0 sets it every frame as before. (SDL3 only:
+// the SDL2 build is not the port's.)
+static int32 swapIntervalSet = -1;
+static bool32 swapIntervalCache = 1;
+
+static void
+setSwapInterval(int32 interval)
+{
+	if(swapIntervalCache && interval == swapIntervalSet)
+		return;
+	bool ok = SDL_GL_SetSwapInterval(interval);
+	swapIntervalSet = ok ? interval : -1;
+}
+#endif
