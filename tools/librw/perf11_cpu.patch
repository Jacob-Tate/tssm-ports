+// TSSM port (perf11_cpu): a stream buffer is given storage of the batch's own
+// size, with the batch in it, in one call. It used to be orphaned at 10000
+// elements (280 KB of im2d vertices, 360 KB of im3d) and then written: about
+// 15 times a frame, 400 MB a second of fresh buffer storage at 120 fps for a
+// HUD, shadows and screen passes that hand over a few kilobytes. A new store
+// each time is still what keeps the driver from waiting on draws that read
+// the old one. Not a ring written in place with glBufferSubData or a mapping:
+// what those cost depends on how the driver handles a write to a buffer the
+// GPU may still be reading, from a stall to a copy of the whole buffer, and
+// mapping was 2.5 times slower on NVIDIA. TSSM_GL_STREAM=0 is the old way.
+static bool32 streamExact = 1;
+
+static void
+streamData(GLenum target, uint32 buffer, int32 n, int32 usual, uint32 elemSize, void *data)
+{
+	glBindBuffer(target, buffer);
+	if(streamExact)
+		glBufferData(target, n*elemSize, data, GL_STREAM_DRAW);
+	else{
+		glBufferData(target, streamSize(n, usual)*elemSize, nil, GL_STREAM_DRAW);
+		glBufferSubData(target, 0, n*elemSize, data);
+	}
+}
