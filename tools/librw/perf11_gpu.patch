+// TSSM port: discard depth and stencil of the framebuffer bound to `target`
+// (VSOPT_INVALIDATE). A tiling GPU then does not write them out at the end of
+// the pass; nothing reads either after the point this is called.
+static void
+invalidateDepthStencil(GLenum target)
+{
+	if(!(virtualScreenOptions & VSOPT_INVALIDATE) || glad_glInvalidateFramebuffer == nil)
+		return;
+	static const GLenum ds[] = { GL_DEPTH_ATTACHMENT, GL_STENCIL_ATTACHMENT };
+	glInvalidateFramebuffer(target, 2, ds);
+}
+
+// TSSM port: discard every sample of the explicit multisampled buffer, colour
+// as well as depth and stencil (VSOPT_DISCARDMS with VSOPT_INVALIDATE), once
+// its colour has been folded into virtualScreenFbo. A tiling GPU then does not
+// write the samples out to memory: at 2340x1080 with 4x, about 40 MB a frame.
+// Off by default because the next frame does read them: a frame clears only
+// depth, and where the scene leaves a sample undrawn (cracks between
+// triangles) or blends onto it, it is last frame's colour. It is bound to
+// GL_READ_FRAMEBUFFER here, so that the call names it; the caller binds what
+// it needs next. Never with render-to-texture anti-aliasing, whose colour
+// attachment is the picture itself, and never on desktop GL
+// (virtualScreenDiscardsMS).
+static void
+invalidateVirtualScreenMS(void)
+{
+	if(!virtualScreenDiscardsMS())
+		return;
+	static const GLenum all[] = { GL_COLOR_ATTACHMENT0, GL_DEPTH_ATTACHMENT,
+	                              GL_STENCIL_ATTACHMENT };
+	glBindFramebuffer(GL_READ_FRAMEBUFFER, virtualScreenMSFbo);
+	glInvalidateFramebuffer(GL_READ_FRAMEBUFFER, 3, all);
+}
+
+// TSSM port: the frame has been read back (VSOPT_SINGLESAMPLEPOST). From here
+// to the present everything drawn into the virtual screen goes into the
+// single-sample buffer, with the scene's depth, so the explicit multisampled
+// buffer is entered once per frame: a tiling GPU does not have to write every
+// sample of colour and depth out and read them all back in to draw the glow's
+// composite and the HUD. What changes is that those draws are not
+// anti-aliased: the glow is a full-screen quad and the HUD is mostly 2D, whose
+// edges are in its art. Not quite all of them: where a letter's quad cuts
+// through its art, the quad's edge is hard instead of partly covered (a few
+// pixels of each line of dialog text, up to about 110 of 255).
+//
+// Only on GLES without render-to-texture anti-aliasing, which is every GLES
+// by default. With it, going back into the multisampled framebuffer reads the
+// folded colour, as the single-sample one would, so it costs the same and the
+// HUD keeps its anti-aliasing (VSOPT_POSTALWAYS uses it anyway, for
+// comparisons); the depth it is meant to read as well is not kept on Adreno
+// (VSOPT_MSRTT). A desktop GPU does not pay for entering a framebuffer again
+// at all.
+static void
+enterVirtualScreenPost(void)
+{
+	if(!(virtualScreenOptions & VSOPT_SINGLESAMPLEPOST) || virtualScreenPost ||
+	   virtualScreenMSFbo == 0 || virtualScreenFbo == 0)
+		return;
+	if(!(virtualScreenOptions & VSOPT_POSTALWAYS) && (!gl3Caps.gles || virtualScreenMSRTT))
+		return;
+	// Only inside a frame: a read after the present (a snapshot) has nothing
+	// left to draw, and the next frame starts in the multisampled buffer.
+	if(!virtualScreenMSDrawn)
+		return;
+	if(!virtualScreenMSRTT && !virtualScreenResolved){
+		// Explicit samples: fold colour and depth with a blit.
+		glBindFramebuffer(GL_READ_FRAMEBUFFER, virtualScreenMSFbo);
+		glBindFramebuffer(GL_DRAW_FRAMEBUFFER, virtualScreenFbo);
+		glDisable(GL_SCISSOR_TEST);
+		glBlitFramebuffer(0, 0, virtualScreenWidth, virtualScreenHeight,
+		                  0, 0, virtualScreenWidth, virtualScreenHeight,
+		                  GL_COLOR_BUFFER_BIT, GL_NEAREST);
+		glBlitFramebuffer(0, 0, virtualScreenWidth, virtualScreenHeight,
+		                  0, 0, virtualScreenWidth, virtualScreenHeight,
+		                  GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT, GL_NEAREST);
+		invalidateDepthStencil(GL_READ_FRAMEBUFFER);
+		// Folded, colour and depth. Until the present nothing enters the
+		// multisampled buffer again: setFrameBuffer sends its cameras to
+		// virtualScreenFbo while virtualScreenPost is set, and the binding
+		// below is moved there too. Nothing reads it: resolveVirtualScreen
+		// returns at once, and the readers of the frame (copyVirtualScreen,
+		// the read view, a raster lock, the present) read virtualScreenFbo.
+		// Only the next frame does (VSOPT_DISCARDMS).
+		invalidateVirtualScreenMS();
+		rebindFramebuffer();
+		virtualScreenResolved = 1;
+	}
+	virtualScreenPost = 1;
+	// A camera of the virtual screen that is in an update now draws into the
+	// multisampled buffer; the next setFrameBuffer moves it.
+	if(currentFramebuffer == virtualScreenMSFbo)
+		bindFramebuffer(virtualScreenFbo);
+}
