+// TSSM port: the picture as a texture to sample, without copying it: a
+// Raster that names virtualScreenTex. For an effect whose first pass reads
+// the frame into a target of its own (the glow's first halving); NOT for one
+// that draws back into the frame while reading it, which needs
+// copyVirtualScreen. Puts the frame into the single-sample state first, as a
+// copy would. Nil when there is no virtual screen or VSOPT_READVIEW is off.
+Raster*
+virtualScreenReadRaster(void)
+{
+	if(!(virtualScreenOptions & VSOPT_READVIEW) || virtualScreenFbo == 0 || virtualScreenTex == 0)
+		return nil;
+	if(virtualScreenView == nil){
+		virtualScreenView = Raster::create(virtualScreenWidth, virtualScreenHeight, 32,
+		                                   Raster::CAMERATEXTURE | Raster::C8888 |
+		                                   Raster::DONTALLOCATE, PLATFORM_GL3);
+		if(virtualScreenView == nil)
+			return nil;
+	}
+	Gl3Raster *natras = PLUGINOFFSET(Gl3Raster, virtualScreenView, nativeRasterOffset);
+	if(natras->texid != virtualScreenTex || virtualScreenView->width != virtualScreenWidth ||
+	   virtualScreenView->height != virtualScreenHeight){
+		evictRaster(virtualScreenView);
+		virtualScreenView->width = virtualScreenWidth;
+		virtualScreenView->height = virtualScreenHeight;
+		// As a camera texture of C8888 is made, sampled as virtualScreenFramebuffer
+		// made the texture: linear and clamped.
+		natras->internalFormat = GL_RGBA8;
+		natras->format = GL_RGBA;
+		natras->type = GL_UNSIGNED_BYTE;
+		natras->hasAlpha = 1;
+		natras->alphaKind = ALPHAGRADED;
+		natras->bpp = 4;
+		natras->numLevels = 1;
+		natras->autogenMipmap = 0;
+		natras->texid = virtualScreenTex;
+		natras->fbo = 0;
+		natras->fboMate = nil;
+		natras->filterMode = Texture::LINEAR;
+		natras->addressU = Texture::CLAMP;
+		natras->addressV = Texture::CLAMP;
+		natras->maxAnisotropy = 1;
+	}
+	enterVirtualScreenPost();
+	resolveVirtualScreen();
+	return virtualScreenView;
+}
+
+static void
+destroyVirtualScreenView(void)
+{
+	if(virtualScreenView == nil)
+		return;
+	Gl3Raster *natras = PLUGINOFFSET(Gl3Raster, virtualScreenView, nativeRasterOffset);
+	// The texture is the virtual screen's, deleted with it.
+	natras->texid = 0;
+	natras->fbo = 0;
+	virtualScreenView->destroy();
+	virtualScreenView = nil;
+}
