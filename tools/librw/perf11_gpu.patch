+// A tiling GPU keeps the samples in its tile memory and writes out only the
+// folded pixel, so a frame costs one write of the picture instead of a write
+// of every sample and a resolve that reads them all back. The catch is that
+// the samples do not survive the end of a render pass -- only the folded
+// pixels do -- so the multisampled buffer must be entered once per frame:
+// the shadows are drawn before the scene (xShadow.cpp, PLATFORM_PC), and once
+// the frame has been read (the glow) the rest goes into the single-sample
+// buffer (virtualScreenPost). The depth is a texture, not a renderbuffer, so
+// that the single-sample buffer can carry on with the scene's depth.
+// Only the folded colour is sure to survive, though:
+// EXT_multisampled_render_to_texture2 lets the driver discard a multisampled
+// depth texture at the end of a pass, as if invalidated (only a depth
+// renderbuffer is kept), and the phone's Adreno does. Whatever is drawn after
+// the frame was left and entered again then depth-tests against undefined
+// depth, which is why this path is off in VSOPT_DEFAULT (VSOPT_MSRTT). A
+// desktop driver may keep it; none has to.
+typedef void (APIENTRYP PFN_FramebufferTexture2DMultisampleEXT)(GLenum, GLenum, GLenum, GLuint,
+                                                                 GLint, GLsizei);
+#define VS_GL_MAX_SAMPLES_EXT 0x8D57
+#define VS_GL_TEXTURE_SAMPLES_EXT 0x8D6C
+
+static bool32
+acquireVirtualScreenMSRTT(int32 want)
+{
+#if defined(LIBRW_SDL2) || defined(LIBRW_SDL3)
+	if(!SDL_GL_ExtensionSupported("GL_EXT_multisampled_render_to_texture") ||
+	   !SDL_GL_ExtensionSupported("GL_EXT_multisampled_render_to_texture2"))
+		return 0;
+	PFN_FramebufferTexture2DMultisampleEXT fbTexMS = (PFN_FramebufferTexture2DMultisampleEXT)
+		SDL_GL_GetProcAddress("glFramebufferTexture2DMultisampleEXT");
+	if(fbTexMS == nil)
+		return 0;
+
+	int32 maxSamples = 0;
+	glGetIntegerv(VS_GL_MAX_SAMPLES_EXT, &maxSamples);
+	if(want > maxSamples)
+		want = maxSamples;
+	if(want <= 1)
+		return 0;
+
+	// Depth only: nothing in the game tests stencil, and a depth texture of
+	// this format is core GLES 3.
+	glGenTextures(1, &virtualScreenDepthTex);
+	uint32 prev = bindTexture(virtualScreenDepthTex);
+	glTexImage2D(GL_TEXTURE_2D, 0, GL_DEPTH_COMPONENT24, virtualScreenWidth, virtualScreenHeight,
+	             0, GL_DEPTH_COMPONENT, GL_UNSIGNED_INT, nil);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+	glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+	bindTexture(prev);
+
+	uint32 prevFbo = currentFramebuffer;
+	bool32 ok = 1;
+
+	// The single-sample buffer takes the depth texture in place of its own
+	// renderbuffer, so that it holds the scene's depth after the fold.
+	bindFramebuffer(virtualScreenFbo);
+	glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_RENDERBUFFER, 0);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D,
+	                       virtualScreenDepthTex, 0);
+	if(glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+		ok = 0;
+
+	if(ok){
+		glGenFramebuffers(1, &virtualScreenMSFbo);
+		bindFramebuffer(virtualScreenMSFbo);
+		fbTexMS(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, virtualScreenTex, 0, want);
+		fbTexMS(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, virtualScreenDepthTex, 0,
+		        want);
+		if(glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+			ok = 0;
+		else{
+			GLint granted = 0;
+			glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+			                                      VS_GL_TEXTURE_SAMPLES_EXT, &granted);
+			if(granted > 1)
+				want = granted;
+		}
+	}
+
+	if(!ok){
+		// Back to the explicit pair: the single-sample buffer gets its own
+		// depth renderbuffer again.
+		bindFramebuffer(virtualScreenFbo);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, 0, 0);
+		glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_RENDERBUFFER,
+		                          virtualScreenDepth);
+		bindFramebuffer(prevFbo);
+		if(virtualScreenMSFbo){
+			deleteFramebuffer(virtualScreenMSFbo);
+			virtualScreenMSFbo = 0;
+		}
+		deleteTexture(virtualScreenDepthTex);
+		virtualScreenDepthTex = 0;
+		printf("librw: EXT_multisampled_render_to_texture refused the virtual screen; "
+		       "resolving explicitly\n");
+		return 0;
+	}
+
+	bindFramebuffer(prevFbo);
+	// Its own depth renderbuffer is no longer attached anywhere.
+	glDeleteRenderbuffers(1, &virtualScreenDepth);
+	virtualScreenDepth = 0;
+	virtualScreenMSRTT = 1;
+	virtualScreenSamples = want;
+	printf("librw: %dx anti-aliasing through EXT_multisampled_render_to_texture\n", want);
+	return 1;
+#else
+	return 0;
+#endif
+}
