+// GameCube native data is kept as read until the skin after it is in.
+//
+// A native geometry that has no native data by now -- its chunk was missing or
+// for a platform nobody reads -- would reach a backend that neither instances
+// nor draws native geometry without it; it becomes the same empty stand-in as
+// a GameCube geometry that cannot be read.
+static void
+alwaysNativeData(void *object, int32, int32)
+{
+	Geometry *geometry = (Geometry*)object;
+	if(geometry->instData && geometry->instData->platform == PLATFORM_GC)
+		finishNativeDataGC(object);
+	else if(geometry->instData == nil && (geometry->flags & Geometry::NATIVE))
+		stubNativeDataGC(object);
+}
