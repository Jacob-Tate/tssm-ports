index 813bf63..c8f1671 100644
--- a/src/d3d/shaders/skin_VS.hlsl
+++ b/src/d3d/shaders/skin_VS.hlsl
@@ -21,6 +21,16 @@ float4 toonCamPos : register(c236);
 
 float4x3 boneMatrices[64] : register(c41);
 
+#ifdef UVXFORM
+// The texture coordinate transform, as default_VS.hlsl has it: two rows of a
+// 2x4 that multiplies (u, v, 1, 1). Not at c41, where default_VS.hlsl keeps it,
+// because the bones run from there to c232; and past c238, the last of the
+// skinned env map's constants, so that no other pipeline's upload lands on it.
+// d3d9skinmatfx.cpp uploads it right before the draw that reads it.
+float4		uvXform0	: register(c239);
+float4		uvXform1	: register(c240);
+#endif
+
 struct VS_in
 {
 	float4 Position		: POSITION;
@@ -146,7 +156,12 @@ VS_out main(in VS_in input)
 	float3 Vertex = mul(worldMat, float4(SkinVertex, 1.0)).xyz;
 	float3 Normal = mul(normalMat, SkinNormal);
 
+#ifdef UVXFORM
+	float4 uv = float4(input.TexCoord, 1.0, 1.0);
+	output.TexCoord0.xy = float2(dot(uvXform0, uv), dot(uvXform1, uv));
+#else
 	output.TexCoord0.xy = input.TexCoord;
+#endif
 
 	output.Color = input.Prelight;
 
