diff --git a/src/matfx.cpp b/src/matfx.cpp
index 58ed8d1..d1d5c6d 100644
--- a/src/matfx.cpp
+++ b/src/matfx.cpp
@@ -402,6 +402,43 @@ MatFX::getUVTransformMatrices(Matrix **base, Matrix **dual)
 	if(dual) *dual = nil;
 }
 
+// The base UV transform, as the two rows of the 2x4 matrix that rw::uvTransform
+// and the uvXform shaders use: they multiply (u, v, 1, 1), so the matrix's
+// translation goes in the third column and the fourth is zero.
+//
+// RenderWare applies the matrix to a texture coordinate the way it applies any
+// RwMatrix to a point -- as a row vector, (u, v, 0, 1) times the matrix -- so
+// u' = u*right.x + v*up.x + pos.x and v' = u*right.y + v*up.y + pos.y. The at
+// row would take a third coordinate, which a texture coordinate does not have.
+//
+// The matrix is the application's: setUVTransformMatrices keeps the pointer,
+// as RenderWare does, so this is read at draw time and an application that
+// rewrites the matrix between draws animates the surface.
+bool32
+MatFX::getUVTransform(const Material *m, float32 *xform)
+{
+	MatFX *matfx = MatFX::get(m);
+	if(matfx == nil)
+		return 0;
+	if(matfx->type != UVTRANSFORM && matfx->type != DUALUVTRANSFORM)
+		return 0;
+	int32 i = matfx->getEffectIndex(UVTRANSFORM);
+	if(i < 0)
+		return 0;
+	Matrix *b = matfx->fx[i].uvtransform.baseTransform;
+	if(b == nil)
+		return 0;
+	xform[0] = b->right.x;
+	xform[1] = b->up.x;
+	xform[2] = b->pos.x;
+	xform[3] = 0.0f;
+	xform[4] = b->right.y;
+	xform[5] = b->up.y;
+	xform[6] = b->pos.y;
+	xform[7] = 0.0f;
+	return 1;
+}
+
