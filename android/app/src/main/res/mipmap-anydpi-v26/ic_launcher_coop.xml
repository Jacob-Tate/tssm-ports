<?xml version="1.0" encoding="utf-8"?>
<!-- The co-op app's icon: the game's icon with coop_badge over it. Both
     layers come from build.gradle (coop_icon_*), which names whichever icon
     the build uses. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/coop_icon_background" />
    <foreground android:drawable="@drawable/coop_icon_foreground" />
</adaptive-icon>
