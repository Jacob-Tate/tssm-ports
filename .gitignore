# IDE folders
.idea/
.vs/

# Caches
__pycache__
.mypy_cache
.cache/

# Original files
orig/*/*
!orig/*/.gitkeep
*.dol
*.rel
*.elf
*.o
*.map
*.MAP

# Build files
build/
.ninja_*
build.ninja

# decompctx output
ctx.*
*.ctx

# Generated configs
objdiff.json
compile_commands.json

# Miscellaneous
/*.txt
# ...but not the PC port's build (/*.txt above would cover it)
!/CMakeLists.txt
*.exe

# PC port build directories and output (CMakeLists.txt, build-*.bat)
/build-*/
/build-pc/
/bin/
CMakeUserPresets.json

# Taken by CMake while it applies tools/librw/*.patch
tools/librw/cmake.lock

# App icon art (docs/ICON.md). The picture and everything tools/make_icons.ps1
# makes from it stay outside the repository; these catch a copy made inside it
# anyway. tools/check_icon_art.py checks what is staged.
/local-assets/
/icons/
*.ico
*.icns
tssm-logo*
ic_launcher_foreground.png
tssm_icon.xml
icon-64.png
play-512.png
preview.png
/icon.jpg
# The repository's own default icon (tools/check_icon_art.py lists it).
!/dist/pc/default_icon.ico

# Local assistant and editor-tool folders and notes: never part of the project
.claude/
.specstory/
.cursor/
.gemini/
CLAUDE.md
PROGRESS_NOTES.md
*HANDOFF*

# Game files and disc images: never part of the project (orig/ is covered above)
*.[iI][sS][oO]
*.[rR][vV][zZ]
*.[gG][cC][mM]
*.[wW][bB][fF][sS]
*.[cC][iI][sS][oO]
*.[xX][bB][eE]
*.[hH][iI][pP]
*.[hH][oO][pP]
*.[bB][iI][kK]
/xbox-assets/

# Built programs and their settings: never part of the project (the build folders are
# ignored above or in their own .gitignore files)
*.nro
*.nacp
*.apk
*.pdb
*.dll
*.so
config.ini
